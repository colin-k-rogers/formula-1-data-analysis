# Config for setup.sh / run.sh. Copy this to .env (git-ignored — see
# ../../.gitignore) and edit the placeholders for your AWS account before
# running either script:
#   cp .env.example .env

ACCOUNT_ID=123456789012
REGION=us-east-1
BUCKET_NAME=f1-radio-topics-lakehouse
REPO_NAME=f1-radio-topics
IMAGE_TAG=latest

# Check `aws emr-serverless list-release-labels --region <REGION>` for the
# current release — this may not be the latest by the time you read it.
EMR_RELEASE=emr-7.5.0

# Matches ICEBERG_CATALOG_NAME in job.py.
CATALOG_NAME=radio
# Matches ICEBERG_NAMESPACE in job.py — this becomes the Glue database name.
ICEBERG_NAMESPACE=raw

SEASON_YEAR=2026
