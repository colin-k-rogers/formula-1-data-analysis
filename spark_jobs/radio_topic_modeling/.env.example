# Config for setup.sh / run.sh. Copy this to .env (git-ignored — see
# ../../.gitignore) and edit the placeholders for your AWS account before
# running either script:
#   cp .env.example .env

ACCOUNT_ID=123456789012
REGION=us-east-1
BUCKET_NAME=f1-radio-topics-lakehouse
REPO_NAME=f1-radio-topics
IMAGE_TAG=latest

# Optional: named AWS CLI profile (~/.aws/config) to run every `aws`/`docker
# login` call in setup.sh/run.sh as, instead of your default credentials.
# Uncomment and set if you use named profiles.
# AWS_PROFILE=my-profile

# Check `aws emr-serverless list-release-labels --region <REGION>` for the
# current release — this may not be the latest by the time you read it.
EMR_RELEASE=emr-7.5.0

# CPU architecture for both the EMR Serverless application and the
# container image build -- these MUST match ("Custom image architecture
# doesn't match application architecture" if they don't). Use "arm64" if
# you're building on Apple Silicon (native, fast) or want Graviton's lower
# EMR Serverless pricing; use "x86_64" if you're on an Intel/AMD machine.
# Immutable after the application is first created — change this before
# ./setup.sh ever runs, not after.
ARCHITECTURE=arm64

# Matches ICEBERG_CATALOG_NAME in job.py.
CATALOG_NAME=radio
# Matches ICEBERG_NAMESPACE in job.py — this becomes the Glue database name.
ICEBERG_NAMESPACE=raw

SEASON_YEAR=2026
